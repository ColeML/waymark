# ── Database ──────────────────────────────────────────────────────────────────────────────────
# Two connection strings, and they are not interchangeable. The Neon integration sets both in
# Vercel. Locally, point them at a Neon branch, or run `docker compose up -d` and use the values
# below.

# Pooled (host contains `-pooler`). The app queries through this at runtime.
# With docker compose: postgres://waymark:waymark@db:5432/waymark (host `db`, which the proxy
# resolves inside the compose network).
DATABASE_URL=

# Direct. Used only by `pnpm db:migrate`, because pooled connections do not support the
# session-level state DDL needs. With docker compose: postgres://waymark:waymark@localhost:5456/waymark
DATABASE_URL_UNPOOLED=

# Only for a Postgres on this machine, and only outside production. The app's driver speaks Neon's
# WebSocket protocol rather than plain TCP, so it reaches a local database through the wsproxy in
# docker-compose.yml. Unset means talk to Neon directly. With docker compose: localhost:5457/v1
DATABASE_WS_PROXY=
